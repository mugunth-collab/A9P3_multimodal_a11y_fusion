digraph MLF {
  graph [rankdir=TB, fontname="Helvetica", fontsize=14, nodesep=0.14, ranksep=0.16, newrank=true, pad=0.03, margin=0];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, fillcolor="#eeeeee", color="#777777", margin="0.06,0.03", height=0.3];
  edge  [color="#555555", arrowsize=0.6, fontname="Helvetica", fontsize=12];

  subgraph cluster_data {
    label="1 Capture on device"; style="rounded,filled"; margin=7; fillcolor="#f4f4f4"; color="#bbbbbb";
    ui  [label="screen +\nview tree"];
    run [label="OCR, caption,\nruntime probes"];
  }
  subgraph cluster_pre {
    label="2 Pre-processing"; labeljust="l"; style="rounded,filled"; margin=7; fillcolor="#f4f4f4"; color="#bbbbbb";
    prep [label="impute + flags, winsorise,\nz-score, split by modality"];
  }
  subgraph cluster_model {
    label="3 Proposed MLF"; labelloc="b"; labeljust="l"; style="rounded,filled"; margin=7; fillcolor="#fdecea"; color="#e3a49c";
    node [fillcolor="#f6c6c0", color="#c0392b"];
    ev [label="f_V(x_V)\n16 in, Eq. (1)"]; et [label="f_T(x_T)\n5 in, Eq. (1)"]; ec [label="f_C(x_C)\n27 in, Eq. (1)"];
    md [label="modality dropout\nm_k, Eq. (2)"];
    fu [label="fusion head\nz, Eq. (3)"];
    aux [label="aux heads\nz_k, Eq. (5)"];
    stop [label="patience met?", shape=diamond, style="filled", fillcolor="#f6c6c0", fontsize=12, margin="0.0,0.0", height=0.45];
  }
  subgraph cluster_eval {
    label="4 Decision + evaluation"; style="rounded,filled"; margin=7; fillcolor="#f4f4f4"; color="#bbbbbb";
    thr [label="τ*, Eq. (6)", fillcolor="#f6c6c0", color="#c0392b"];
    out [label="barrier alert"];
    base [label="baselines"];
    met [label="5-fold CV: F1, AUC"];
  }
  ui -> prep; run -> prep;
  {rank=same; ui; run}
  prep -> ev; prep -> et; prep -> ec;
  {rank=same; ev; et; ec}
  ev -> md; et -> md; ec -> md;
  md -> fu; md -> aux;
  {rank=same; fu; aux}
  fu -> stop; aux -> stop [style=dashed];
  stop -> md [xlabel="no ", constraint=false, color="#c0392b", fontcolor="#c0392b"];
  stop -> thr [label=" yes"];
  thr -> out; out -> met; base -> met;
  {rank=same; thr; out}
  {rank=same; met; base}
}
